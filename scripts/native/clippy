#!/bin/bash
set -e
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

WARN_FLAGS="-D warnings"
if [[ " $* " =~ " --relaxed " ]]; then
    WARN_FLAGS=""
fi
# Second pass with the feature on: the registry and its provider are not
# built at all otherwise.
RUSTFLAGS="$WARN_FLAGS" cargo clippy --all-targets
RUSTFLAGS="$WARN_FLAGS" cargo clippy --all-targets --features exfiltrate

